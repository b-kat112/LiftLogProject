<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Add Workout</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main>
        <h1>Add Workout</h1>

        <form action="/workouts/add" method="post">
            <label>Exercise Name:
                <input type="text" name="exerciseName" required>
            </label>

            <label>Muscle Group:
                <input type="text" name="muscleGroup" required>
            </label>

            <label>Sets:
                <input type="number" name="sets" required>
            </label>

            <label>Reps:
                <input type="number" name="reps" required>
            </label>

            <label>Weight:
                <input type="number" name="weight" required>
            </label>

            <label>Notes:
                <textarea name="notes"></textarea>
            </label>

            <button type="submit">Save Workout</button>
        </form>

        <a href="/">HOME</a>
    </main>
</body>
</html>